# Build output
.vs/
bin/
obj/

# Test output - coverage reports and test host logs
TestResults/
*.coverage
*.coveragexml

# IDE
.idea/
.vscode/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Runtime log. system.log is append-only and grows on every run, which is why it
# used to show up as a permanent uncommitted change.
Logs/system.log
Logs/system.err

# Deliberately NOT ignored, for the record:
#   Logs/config.json and Logs/install_history.json are the simulated machine's
#   persisted state. They are tracked so the demo documented in README.md starts
#   from the same version on a fresh clone (a default config would start at 1.0.0,
#   and the documented "update_pkg_1.1.8.txt is the same version, so it is
#   rejected" step would behave differently).
#   Logs/*.txt are the sample update packages - demo fixtures, not output.
